{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["apps/**", "packages/**", "*.json", "!**/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  },
  "overrides": [
    {
      "includes": ["apps/cli/**"],
      "javascript": {
        "formatter": { "quoteStyle": "double", "semicolons": "asNeeded" }
      }
    }
  ]
}
